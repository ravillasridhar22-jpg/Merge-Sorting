// C++ program for the implementation of Shell Sort
#include <bits/stdc++.h>
using namespace std;

void shellSort(vector<int>& v) {
    int n = v.size();

    // Start with a large gap, then reduce the gap
    for (int gap = n / 2; gap > 0; gap /= 2) {

        // Perform insertion sort for this gap
        for (int i = gap; i < n; i++) {

            // Save the current element
            int temp = v[i];

            int j;

            // Shift earlier gap-sorted elements up
            // until the correct location for temp is found
            for (j = i; j >= gap && v[j - gap] > temp; j -= gap) {
                v[j] = v[j - gap];
            }

            // Put temp in its correct location
            v[j] = temp;
        }
    }
}

int main() {
    vector<int> v = {12, 34, 54, 2, 3};

    // Sorting the vector
    shellSort(v);

    cout << "Sorted array: ";
    for (auto i : v)
        cout << i << " ";

    return 0;
}

// C++ program for the implementation of Linear Search
#include <bits/stdc++.h>
using namespace std;

// Function to perform Linear Search
int linearSearch(vector<int>& v, int key) {
    int n = v.size();

    // Traverse the array
    for (int i = 0; i < n; i++) {

        // If the element is found
        if (v[i] == key)
            return i;
    }

    // Element not found
    return -1;
}

int main() {
    vector<int> v = {10, 25, 30, 45, 50, 65};

    int key = 45;

    int result = linearSearch(v, key);

    if (result != -1)
        cout << "Element found at index: " << result << endl;
    else
        cout << "Element not found." << endl;

    return 0;
}

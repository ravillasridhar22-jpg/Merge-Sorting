// C++ program for the implementation of Binary Search
#include <bits/stdc++.h>
using namespace std;

// Function to perform Binary Search
int binarySearch(vector<int>& v, int key) {
    int left = 0;
    int right = v.size() - 1;

    while (left <= right) {
        int mid = left + (right - left) / 2;

        // If the element is found
        if (v[mid] == key)
            return mid;

        // If key is greater, search in the right half
        else if (v[mid] < key)
            left = mid + 1;

        // If key is smaller, search in the left half
        else
            right = mid - 1;
    }

    // Element not found
    return -1;
}

int main() {
    vector<int> v = {2, 5, 8, 12, 16, 23, 38, 56};

    int key = 23;

    int result = binarySearch(v, key);

    if (result != -1)
        cout << "Element found at index: " << result << endl;
    else
        cout << "Element not found." << endl;

    return 0;
}
